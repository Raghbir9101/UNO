<script>
(function () {
  'use strict';
  var STORAGE_KEY = 'uno-score-calc-v1';
  var els = {
    headRow: document.getElementById('calc-head-row'),
    body: document.getElementById('calc-body'),
    totalRow: document.getElementById('calc-total-row'),
    addPlayer: document.getElementById('calc-add-player'),
    addRound: document.getElementById('calc-add-round'),
    reset: document.getElementById('calc-reset'),
    print: document.getElementById('calc-print'),
    target: document.getElementById('calc-target'),
    mode: document.getElementById('calc-mode'),
    modeNote: document.getElementById('calc-mode-note'),
    status: document.getElementById('calc-status'),
  };

  // state: players = [{name}], rounds = [{scores: {playerIndex: number}, winner: index|null}]
  var state = { players: [], rounds: [], target: 500, mode: 'winner' };

  function save() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
  }
  function load() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        var parsed = JSON.parse(raw);
        if (parsed && Array.isArray(parsed.players)) state = parsed;
      }
    } catch (e) {}
    if (!state.players.length) {
      state = { players: [{ name: 'Player 1' }, { name: 'Player 2' }], rounds: [], target: 500, mode: 'winner' };
    }
  }

  function totals() {
    var t = state.players.map(function () { return 0; });
    state.rounds.forEach(function (round) {
      state.players.forEach(function (p, i) {
        var v = Number(round.scores[i]) || 0;
        if (state.mode === 'winner') {
          // winner banks the sum of everyone else's card points
          if (round.winner === i) {
            var sum = 0;
            state.players.forEach(function (_, j) { if (j !== i) sum += Number(round.scores[j]) || 0; });
            t[i] += sum;
          }
        } else {
          t[i] += v; // golf: each player accumulates their own leftover points
        }
      });
    });
    return t;
  }

  function leaderIndex(t) {
    // "Best" depends on mode: winner mode = highest, golf = lowest
    if (!t.length) return -1;
    var best = 0;
    for (var i = 1; i < t.length; i++) {
      if (state.mode === 'winner' ? t[i] > t[best] : t[i] < t[best]) best = i;
    }
    return best;
  }

  function render() {
    // ── header: one <th> per player, before the +Player cell ──
    var addCell = els.headRow.querySelector('.calc-add-col');
    Array.prototype.slice.call(els.headRow.querySelectorAll('.calc-player-th')).forEach(function (n) { n.remove(); });
    state.players.forEach(function (p, i) {
      var th = document.createElement('th');
      th.className = 'calc-player-th';
      var input = document.createElement('input');
      input.className = 'calc-player-name';
      input.value = p.name;
      input.setAttribute('aria-label', 'Player ' + (i + 1) + ' name');
      input.addEventListener('input', function () { state.players[i].name = input.value; save(); });
      th.appendChild(input);
      if (state.players.length > 2) {
        var rm = document.createElement('button');
        rm.className = 'calc-remove-player';
        rm.type = 'button';
        rm.textContent = '✕';
        rm.setAttribute('aria-label', 'Remove ' + p.name);
        rm.addEventListener('click', function () { removePlayer(i); });
        th.appendChild(rm);
      }
      els.headRow.insertBefore(th, addCell);
    });

    // ── body: one row per round ──
    els.body.innerHTML = '';
    state.rounds.forEach(function (round, r) {
      var tr = document.createElement('tr');
      var rc = document.createElement('td');
      rc.className = 'calc-round-col';
      rc.textContent = (r + 1);
      var rm = document.createElement('button');
      rm.className = 'calc-round-remove';
      rm.type = 'button';
      rm.textContent = ' ✕';
      rm.setAttribute('aria-label', 'Remove round ' + (r + 1));
      rm.addEventListener('click', function () { state.rounds.splice(r, 1); save(); render(); });
      rc.appendChild(rm);
      tr.appendChild(rc);

      state.players.forEach(function (p, i) {
        var td = document.createElement('td');
        var input = document.createElement('input');
        input.className = 'calc-score-input';
        input.type = 'number';
        input.min = '0';
        input.setAttribute('inputmode', 'numeric');
        input.value = (round.scores[i] != null ? round.scores[i] : '');
        input.placeholder = '0';
        input.setAttribute('aria-label', p.name + ', round ' + (r + 1) + ' card points');
        input.addEventListener('input', function () {
          round.scores[i] = input.value === '' ? 0 : Number(input.value);
          save(); renderTotals();
        });
        td.appendChild(input);

        if (state.mode === 'winner') {
          var wrap = document.createElement('div');
          wrap.className = 'calc-winner-radio';
          var lbl = document.createElement('label');
          var radio = document.createElement('input');
          radio.type = 'radio';
          radio.name = 'winner-' + r;
          radio.checked = round.winner === i;
          radio.setAttribute('aria-label', p.name + ' won round ' + (r + 1));
          radio.addEventListener('change', function () { round.winner = i; save(); renderTotals(); });
          lbl.appendChild(radio);
          lbl.appendChild(document.createTextNode('won'));
          wrap.appendChild(lbl);
          td.appendChild(wrap);
        }
        tr.appendChild(td);
      });

      var pad = document.createElement('td');
      tr.appendChild(pad);
      els.body.appendChild(tr);
    });

    renderTotals();
  }

  function renderTotals() {
    var t = totals();
    var addCell = els.totalRow.querySelector('.calc-add-col');
    Array.prototype.slice.call(els.totalRow.querySelectorAll('.calc-total')).forEach(function (n) { n.remove(); });
    var lead = leaderIndex(t);
    state.players.forEach(function (p, i) {
      var td = document.createElement('td');
      td.className = 'calc-total';
      if (i === lead && state.rounds.length) td.classList.add('calc-leader');
      td.textContent = t[i];
      els.totalRow.insertBefore(td, addCell);
    });

    // ── win detection ──
    var target = Number(state.target) || 500;
    els.status.classList.remove('is-win');
    if (state.rounds.length) {
      if (state.mode === 'winner') {
        var reached = [];
        t.forEach(function (v, i) { if (v >= target) reached.push(i); });
        if (reached.length) {
          var top = reached.sort(function (a, b) { return t[b] - t[a]; })[0];
          els.status.textContent = '🏆 ' + state.players[top].name + ' wins with ' + t[top] + ' points!';
          els.status.classList.add('is-win');
          return;
        }
      } else {
        var out = [];
        t.forEach(function (v, i) { if (v >= target) out.push(i); });
        if (out.length) {
          els.status.textContent = '🏁 Game over at ' + target + '. Lowest score wins: ' + state.players[lead].name + ' (' + t[lead] + ').';
          els.status.classList.add('is-win');
          return;
        }
      }
      els.status.textContent = 'Leader: ' + state.players[lead].name + ' (' + t[lead] + ')';
    } else {
      els.status.textContent = '';
    }
  }

  function addPlayer() {
    if (state.players.length >= 10) return;
    state.players.push({ name: 'Player ' + (state.players.length + 1) });
    state.rounds.forEach(function (round) { round.scores[state.players.length - 1] = 0; });
    save(); render();
  }
  function removePlayer(idx) {
    state.players.splice(idx, 1);
    state.rounds.forEach(function (round) {
      var next = {};
      Object.keys(round.scores).forEach(function (k) {
        var ki = Number(k);
        if (ki < idx) next[ki] = round.scores[ki];
        else if (ki > idx) next[ki - 1] = round.scores[ki];
      });
      round.scores = next;
      if (round.winner === idx) round.winner = null;
      else if (round.winner > idx) round.winner -= 1;
    });
    save(); render();
  }
  function addRound() {
    var scores = {};
    state.players.forEach(function (_, i) { scores[i] = 0; });
    state.rounds.push({ scores: scores, winner: null });
    save(); render();
    // focus the first score input of the new round
    var lastRow = els.body.lastElementChild;
    if (lastRow) { var f = lastRow.querySelector('.calc-score-input'); if (f) f.focus(); }
  }
  function resetGame() {
    state = { players: [{ name: 'Player 1' }, { name: 'Player 2' }], rounds: [], target: Number(els.target.value) || 500, mode: els.mode.value };
    save(); syncMode(); render();
  }
  function syncMode() {
    els.modeNote.textContent = state.mode === 'winner'
      ? 'Enter the card points left in each losing hand, then mark who went out. The winner banks the total. First to the target wins.'
      : 'Golf mode: enter the card points left in every hand each round. Lowest total when someone hits the target wins.';
  }

  els.addPlayer.addEventListener('click', addPlayer);
  els.addRound.addEventListener('click', addRound);
  els.reset.addEventListener('click', resetGame);
  els.print.addEventListener('click', function () { window.print(); });
  els.target.addEventListener('input', function () { state.target = Number(els.target.value) || 500; save(); renderTotals(); });
  els.mode.addEventListener('change', function () { state.mode = els.mode.value; save(); syncMode(); render(); });

  load();
  els.target.value = state.target || 500;
  els.mode.value = state.mode || 'winner';
  syncMode();
  render();
})();
</script>
<%- include('partials/footer') %>
