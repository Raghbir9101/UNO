<%- include('partials/head') %>
<%- include('partials/nav') %>
<main id="main-content" class="content-page">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span><span>Blog</span>
    </nav>
    <h1>The Play UNO Free Blog</h1>
    <p class="page-subtitle">Original strategy guides, house-rule breakdowns, and tips to help you win more games.</p>

    <p>Everyone knows <em>how</em> to play UNO. Far fewer people play it well. These guides go past the rulebook into the decisions that actually decide games — when to hold a wild, how to read the table, which house rules are worth turning on, and the math behind every draw. Each one is written from real play, and each one ends where it should: with a free game you can jump into.</p>

    <div class="blog-grid">
      <% posts.forEach(function(post) { %>
      <article class="blog-card">
        <p class="blog-meta"><%= post.category %> • <%= post.readTime %></p>
        <h2><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
        <p><%= post.excerpt %></p>
        <a href="/blog/<%= post.slug %>" class="blog-read-more">Read the guide →</a>
      </article>
      <% }); %>
    </div>

    <div class="cta-banner">
      <h3>Done Reading? Time to Play!</h3>
      <p>Put your new strategy to the test. Start a game right now — free, no signup.</p>
      <a href="/play" class="btn btn-hero">Play UNO Now</a>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
