      <aside class="author-box" aria-label="About the author">
        <div class="author-box-avatar" aria-hidden="true">🎴</div>
        <div class="author-box-body">
          <p class="author-box-name">Written by the Play UNO Free team</p>
          <p class="author-box-bio">We build and run <a href="/">Play UNO Free</a>, a browser-based multiplayer UNO game. Our guides come from thousands of real games played on the platform, cross-checked against the official Mattel rulebook. Spot something we got wrong? <a href="/contact">Tell us</a> — we update our guides when the rules or the game change.</p>
        </div>
      </aside>
    </article>

    <div class="cta-banner">
      <h3>Ready to Put This Into Practice?</h3>
      <p>Start a free game right now — no download, no signup, up to 20 players.</p>
      <a href="/play" class="btn btn-hero">Play UNO Free</a>
    </div>

    <% if (typeof related !== 'undefined' && related.length) { %>
    <section class="read-next" aria-label="More from the blog">
      <h2 class="read-next-title">Read Next</h2>
      <div class="blog-grid">
        <% related.forEach(function(r) { %>
        <article class="blog-card">
          <p class="blog-meta"><%= r.category %> • <%= r.readTime %></p>
          <h3><a href="/blog/<%= r.slug %>"><%= r.title %></a></h3>
          <p><%= r.excerpt %></p>
          <a href="/blog/<%= r.slug %>" class="blog-read-more">Read the guide →</a>
        </article>
        <% }); %>
      </div>
    </section>
    <% } %>
  </div>
</main>
<%- include('footer') %>
