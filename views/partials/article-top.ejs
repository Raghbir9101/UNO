<%- include('head') %>
<%- include('nav') %>
<main id="main-content" class="content-page">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span><a href="/blog">Blog</a><span class="sep">›</span><span><%= post.category %></span>
    </nav>
    <article class="blog-article">
      <h1><%= post.title %></h1>
      <p class="article-meta">
        <span class="article-tag"><%= post.category %></span>
        <time datetime="<%= post.date %>"><%= new Date(post.date + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></time>
        <span class="sep">•</span><%= post.readTime %>
      </p>
      <p class="page-subtitle article-lead"><%= post.excerpt %></p>
